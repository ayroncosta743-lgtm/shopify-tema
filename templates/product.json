    "faq": {
      "type": "cod-faq",
      "blocks": {
        "f1": {
          "type": "faq",
          "settings": {
            "open_by_default": true,
            "question": "¿De verdad pago cuando lo recibo?",
            "answer": "<p>Sí. No pedimos tarjeta ni transferencia. Haces el pedido, nosotros lo despachamos y pagas en efectivo al transportador cuando te lo entrega en tu casa.</p>"
          }
        },
        "f2": {
          "type": "faq",
          "settings": {
            "question": "¿Cuánto tarda en llegar?",
            "answer": "<p>Entre 1 y 4 días hábiles según tu ciudad. Las ciudades principales suelen recibir en 24 a 48 horas.</p>"
          }
        },
        "f3": {
          "type": "faq",
          "settings": {
            "question": "¿Hacen envíos a todo el país?",
            "answer": "<p>Sí, enviamos a toda Colombia: Bogotá, Medellín, Cali, Barranquilla, Bucaramanga, Cartagena, Pereira y municipios.</p>"
          }
        },
        "f4": {
          "type": "faq",
          "settings": {
            "question": "¿Y si no me queda la talla?",
            "answer": "<p>Escríbenos por WhatsApp y coordinamos el cambio. Tienes 30 días desde que recibes el pedido.</p>"
          }
        },
        "f5": {
          "type": "faq",
          "settings": {
            "question": "¿Cómo sé que esto es real?",
            "answer": "<p>Somos una tienda registrada, te confirmamos el pedido por WhatsApp con una persona real y solo pagas cuando el producto está en tus manos.</p>"
          }
        }
