          "type": "collapsible_row",
          "settings": {
            "heading": "¿Cómo funciona el pago contra entrega?",
            "icon": "check_box",
            "filled_icon": true,
            "row_content": "<p>Puedes hacer tu pedido en la tienda online y pagarlo en efectivo al recibirlo en tu casa. Así compras con total confianza, sin necesidad de tarjeta.</p>",
