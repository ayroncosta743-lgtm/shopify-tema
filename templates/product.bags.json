        "custom_liquid_zPf76r": {
          "type": "custom_liquid",
          "name": "Liquid personalizado - trust",
          "settings": {
            "custom_liquid": "<ul style=\"list-style: none; padding: 0; margin: 0;\">\n  <li style=\"display: flex; align-items: flex-start; gap: 12px; margin-bottom: 16px;\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0949/1841/0585/files/check.png?v=1752494855\" alt=\"Icono\" style=\"width: 20px; height: 20px;\">\n    <div>\n      <strong>Lleva 2 pares y ahorra en el segundo</strong>\n    </div>\n  </li>\n\n  <li style=\"display: flex; align-items: flex-start; gap: 12px; margin-bottom: 16px;\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0949/1841/0585/files/check.png?v=1752494855\" alt=\"Icono\" style=\"width: 20px; height: 20px;\">\n    <div>\n      <strong>Calidad que se nota</strong><br>\n      Materiales resistentes y acabados limpios.\n\n    </div>\n  </li>\n\n  <li style=\"display: flex; align-items: flex-start; gap: 12px; margin-bottom: 16px;\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0949/1841/0585/files/check.png?v=1752494855\" alt=\"Icono\" style=\"width: 20px; height: 20px;\">\n    <div>\n      <strong>Empaque cuidado</strong><br>\n      Cada par en su caja, listo para regalar.\n\n    </div>\n  </li>\n\n  <li style=\"display: flex; align-items: flex-start; gap: 12px;\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0949/1841/0585/files/check.png?v=1752494855\" alt=\"Icono\" style=\"width: 20px; height: 20px;\">\n    <div>\n      <strong>Hechos para el día a día</strong><br>\n      Cómodos, duraderos y fáciles de combinar.\n\n    </div>\n  </li>\n</ul>"
          }
        },
