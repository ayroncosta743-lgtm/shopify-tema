{% comment %}
  Aviso compacto de garantía dentro de la ficha de producto.

  Acepta:
  - block: {Object}
{% endcomment %}

<div class="cod-mini-guarantee" {{ block.shopify_attributes }}>
  <span class="cod-mini-guarantee__icon">{% render 'cod-icon', icon: block.settings.icon %}</span>
  <span>
    <strong>{{ block.settings.heading }}</strong><br>
    <span class="cod-mini-guarantee__text">{{ block.settings.text }}</span>
  </span>
</div>
