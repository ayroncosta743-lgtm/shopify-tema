{% comment %}
  Contador regresivo reutilizable.

  Acepta:
  - mode: 'daily' | 'evergreen' | 'fixed'
  - minutes: {Number} minutos por visitante (modo evergreen).
  - deadline: {String} fecha ISO, ej. '2026-12-24T23:59' (modo fixed).
  - reset_hour: {Number} hora de reinicio 0-23 (modo daily).
  - show_days: {Boolean}
  - flat: {Boolean} estilo claro en lugar de bloques negros.
  - uid: {String} identificador único (normalmente section.id).
{% endcomment %}

{%- liquid
  assign cd_mode = mode | default: 'daily'
  assign cd_flat = flat | default: false
-%}

<cod-countdown
  class="cod-countdown"
  data-mode="{{ cd_mode }}"
  data-key="{{ uid | default: 'cod' }}"
  {% if cd_mode == 'evergreen' %}data-minutes="{{ minutes | default: 30 }}"{% endif %}
  {% if cd_mode == 'fixed' %}data-deadline="{{ deadline }}"{% endif %}
  {% if cd_mode == 'daily' %}data-reset-hour="{{ reset_hour | default: 0 }}"{% endif %}
  data-on-expire="{{ on_expire | default: 'restart' }}"
>
  {%- if show_days -%}
    <span class="cod-countdown__unit{% if cd_flat %} cod-countdown__unit--flat{% endif %}">
      <span class="cod-countdown__value" data-days>00</span>
      <span class="cod-countdown__label">{{ 'cod.countdown.days' | t }}</span>
    </span>
    <span class="cod-countdown__sep" aria-hidden="true">:</span>
  {%- endif -%}
  <span class="cod-countdown__unit{% if cd_flat %} cod-countdown__unit--flat{% endif %}">
    <span class="cod-countdown__value" data-hours>00</span>
    <span class="cod-countdown__label">{{ 'cod.countdown.hours' | t }}</span>
  </span>
  <span class="cod-countdown__sep" aria-hidden="true">:</span>
  <span class="cod-countdown__unit{% if cd_flat %} cod-countdown__unit--flat{% endif %}">
    <span class="cod-countdown__value" data-minutes>00</span>
    <span class="cod-countdown__label">{{ 'cod.countdown.minutes' | t }}</span>
  </span>
  <span class="cod-countdown__sep" aria-hidden="true">:</span>
  <span class="cod-countdown__unit{% if cd_flat %} cod-countdown__unit--flat{% endif %}">
    <span class="cod-countdown__value" data-seconds>00</span>
    <span class="cod-countdown__label">{{ 'cod.countdown.seconds' | t }}</span>
  </span>
</cod-countdown>
