{% comment %}
  Bloque de precio de alto contraste para la página de producto.

  Acepta:
  - product: {Object}
  - block: {Object}
{% endcomment %}

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign has_discount = false
  if variant.compare_at_price > variant.price
    assign has_discount = true
    assign saved = variant.compare_at_price | minus: variant.price
    assign saved_percent = saved | times: 100 | divided_by: variant.compare_at_price
  endif
-%}

<div class="cod-price-block" {{ block.shopify_attributes }}>
  <span class="cod-price-block__now">{{ variant.price | money }}</span>

  {%- if has_discount -%}
    <span class="cod-price-block__was">{{ variant.compare_at_price | money }}</span>
    {%- if block.settings.show_savings -%}
      <span class="cod-price-block__save">
        {%- if block.settings.savings_format == 'percent' -%}
          -{{ saved_percent }}%
        {%- else -%}
          {{ 'cod.product.you_save' | t: amount: saved | money }}
        {%- endif -%}
      </span>
    {%- endif -%}
  {%- endif -%}
</div>

{%- if block.settings.note != blank -%}
  <p class="cod-price-block__note">{{ block.settings.note }}</p>
{%- endif -%}
