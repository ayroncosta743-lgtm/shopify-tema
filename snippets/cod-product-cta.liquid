{% comment %}
  Botón adicional que lleva al formulario de contra entrega.

  Acepta:
  - block: {Object}
{% endcomment %}

<div class="cod-product-cta" {{ block.shopify_attributes }}>
  <a
    class="cod-btn"
    href="{{ block.settings.link | default: '#CodOrderForm' }}"
    {% if block.settings.scroll_target != blank %}data-cod-scroll="{{ block.settings.scroll_target }}"{% endif %}
    data-cod-primary-cta
  >
    {{ block.settings.label }}
    {%- if block.settings.sublabel != blank -%}
      <span class="cod-btn__sub">{{ block.settings.sublabel }}</span>
    {%- endif -%}
  </a>
</div>
