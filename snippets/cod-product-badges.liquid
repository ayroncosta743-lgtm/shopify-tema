{% comment %}
  Insignias de confianza contra entrega para la página de producto.

  Acepta:
  - block: {Object}
{% endcomment %}

<div class="cod-badge-row" {{ block.shopify_attributes }}>
  {%- if block.settings.badge_1 != blank -%}
    <span class="cod-badge cod-badge--cod">
      {% render 'cod-icon', icon: block.settings.icon_1 %}
      {{ block.settings.badge_1 }}
    </span>
  {%- endif -%}
  {%- if block.settings.badge_2 != blank -%}
    <span class="cod-badge cod-badge--cod">
      {% render 'cod-icon', icon: block.settings.icon_2 %}
      {{ block.settings.badge_2 }}
    </span>
  {%- endif -%}
  {%- if block.settings.badge_3 != blank -%}
    <span class="cod-badge cod-badge--cod">
      {% render 'cod-icon', icon: block.settings.icon_3 %}
      {{ block.settings.badge_3 }}
    </span>
  {%- endif -%}
</div>
