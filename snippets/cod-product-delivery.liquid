{% comment %}
  Estimación de entrega calculada desde hoy.

  Acepta:
  - block: {Object}
{% endcomment %}

{%- liquid
  assign day_seconds = 86400
  assign now_stamp = 'now' | date: '%s' | times: 1

  assign from_stamp = block.settings.days_min | times: day_seconds | plus: now_stamp
  assign to_stamp = block.settings.days_max | times: day_seconds | plus: now_stamp

  assign months = 'enero,febrero,marzo,abril,mayo,junio,julio,agosto,septiembre,octubre,noviembre,diciembre' | split: ','

  assign from_month_index = from_stamp | date: '%m' | times: 1 | minus: 1
  assign to_month_index = to_stamp | date: '%m' | times: 1 | minus: 1

  assign from_label = from_stamp | date: '%-d' | append: ' de ' | append: months[from_month_index]
  assign to_label = to_stamp | date: '%-d' | append: ' de ' | append: months[to_month_index]
-%}

<div class="cod-delivery" {{ block.shopify_attributes }}>
  <span class="cod-delivery__icon">{% render 'cod-icon', icon: 'truck' %}</span>
  <span>
    <strong>{{ block.settings.heading }}</strong><br>
    {{ 'cod.product.delivery_estimate' | t: from_date: from_label, to_date: to_label }}
    {%- if block.settings.note != blank -%}
      <br><span class="cod-delivery__note">{{ block.settings.note }}</span>
    {%- endif -%}
  </span>
</div>

{%- style -%}
  .cod-delivery {
    display: flex;
    gap: 1.2rem;
    align-items: flex-start;
    padding: 1.4rem;
    border-radius: var(--cod-radius);
    border: 1px dashed rgba(var(--cod-success), 0.5);
    background: rgba(var(--cod-success), 0.05);
    font-size: 1.35rem;
    line-height: 1.5;
  }

  .cod-delivery__icon {
    flex: 0 0 auto;
    color: rgb(var(--cod-success));
    display: grid;
    place-items: center;
  }

  .cod-delivery__icon svg { width: 2.4rem; height: 2.4rem; }
  .cod-delivery__note { opacity: 0.75; font-size: 1.25rem; }
{%- endstyle -%}
