{{ 'cod-theme.css' | asset_url | stylesheet_tag }}

<div class="cod-section color-{{ section.settings.color_scheme }}" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="cod-section__inner">
    {%- if section.settings.heading != blank -%}
      <div class="cod-section__head">
        <h2 class="cod-title cod-title--sm">{{ section.settings.heading }}</h2>
        {%- if section.settings.show_divider -%}<span class="cod-divider"></span>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="cod-assurance">
      {%- for block in section.blocks -%}
        <div class="cod-assurance__item" {{ block.shopify_attributes }}>
          <span class="cod-assurance__icon">{% render 'cod-icon', icon: block.settings.icon %}</span>
          <span>
            <strong>{{ block.settings.title }}</strong>
            {%- if block.settings.text != blank -%}
              <br><span style="opacity: .75; font-weight: 500;">{{ block.settings.text }}</span>
            {%- endif -%}
          </span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "COD · Confianza",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título (opcional)" },
    { "type": "checkbox", "id": "show_divider", "default": true, "label": "Mostrar línea decorativa" },
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-1", "label": "Esquema de color" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "default": 32, "unit": "px", "label": "Espaciado superior" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "default": 32, "unit": "px", "label": "Espaciado inferior" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Garantía",
      "settings": [
        { "type": "text", "id": "title", "default": "Pago contra entrega", "label": "Título" },
        { "type": "text", "id": "text", "default": "Pagas en efectivo al recibir", "label": "Texto" },
        {
          "type": "select",
          "id": "icon",
          "default": "cash",
          "label": "Ícono",
          "options": [
            { "value": "cash", "label": "Efectivo" },
            { "value": "truck", "label": "Envío" },
            { "value": "shield", "label": "Garantía" },
            { "value": "return", "label": "Devolución" },
            { "value": "phone", "label": "Teléfono" },
            { "value": "chat", "label": "Chat" },
            { "value": "package", "label": "Paquete" },
            { "value": "check-circle", "label": "Check" },
            { "value": "lock", "label": "Candado" },
            { "value": "map-pin", "label": "Ubicación" },
            { "value": "users", "label": "Clientes" },
            { "value": "thumbs-up", "label": "Pulgar arriba" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "COD · Confianza",
      "blocks": [
        { "type": "item", "settings": { "icon": "cash", "title": "Pago contra entrega", "text": "Pagas en efectivo al recibir" } },
        { "type": "item", "settings": { "icon": "truck", "title": "Envío gratis", "text": "A toda Colombia" } },
        { "type": "item", "settings": { "icon": "return", "title": "Cambios fáciles", "text": "30 días para cambiar" } },
        { "type": "item", "settings": { "icon": "chat", "title": "Te acompañamos", "text": "Soporte por WhatsApp" } }
      ]
    }
  ]
}
{% endschema %}
