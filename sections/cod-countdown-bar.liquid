{{ 'cod-theme.css' | asset_url | stylesheet_tag }}

<div
  class="cod-countdown-bar color-{{ section.settings.color_scheme }}"
  data-cod-countdown-section
  {% if section.settings.sticky %}style="position: sticky; top: 0; z-index: 30;"{% endif %}
>
  <div class="cod-countdown-bar__inner">
    {%- if section.settings.text != blank -%}
      <p class="cod-countdown-bar__text">
        {%- if section.settings.show_icon -%}
          <span class="cod-countdown-bar__icon">{% render 'cod-icon', icon: 'fire' %}</span>
        {%- endif -%}
        {{ section.settings.text }}
      </p>
    {%- endif -%}

    {% render 'cod-countdown',
      mode: section.settings.mode,
      minutes: section.settings.minutes,
      deadline: section.settings.deadline,
      reset_hour: section.settings.reset_hour,
      show_days: section.settings.show_days,
      flat: section.settings.flat_style,
      on_expire: section.settings.on_expire,
      uid: section.id
    %}

    {%- if section.settings.cta_label != blank -%}
      <a
        class="cod-btn cod-btn--auto cod-countdown-bar__cta"
        href="{{ section.settings.cta_link | default: '#' }}"
        {% if section.settings.cta_scroll_target != blank %}
          data-cod-scroll="{{ section.settings.cta_scroll_target }}"
        {% endif %}
      >
        {{ section.settings.cta_label }}
      </a>
    {%- endif -%}
  </div>
</div>

{%- style -%}
  #shopify-section-{{ section.id }} .cod-countdown-bar {
    padding: {{ section.settings.padding_vertical }}px 1.6rem;
  }

  #shopify-section-{{ section.id }} .cod-countdown-bar__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.2rem 2rem;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .cod-countdown-bar__text {
    margin: 0;
    font-size: clamp(1.4rem, 3.6vw, 1.8rem);
    font-weight: 800;
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
  }

  #shopify-section-{{ section.id }} .cod-countdown-bar__icon svg {
    width: 2rem;
    height: 2rem;
    color: rgb(var(--cod-primary));
  }

  #shopify-section-{{ section.id }} .cod-countdown-bar__cta {
    min-height: 4.4rem;
    padding: 1rem 2rem;
    font-size: 1.4rem;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .cod-countdown-bar__inner { gap: 1rem; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "COD · Contador",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Usa el contador solo si la promoción termina de verdad. En Colombia la SIC sanciona los descuentos y plazos falsos."
    },
    { "type": "text", "id": "text", "default": "¡La promoción termina en!", "label": "Texto" },
    { "type": "checkbox", "id": "show_icon", "default": true, "label": "Mostrar ícono" },
    { "type": "header", "content": "Funcionamiento" },
    {
      "type": "select",
      "id": "mode",
      "default": "daily",
      "label": "Tipo de cuenta regresiva",
      "options": [
        { "value": "daily", "label": "Diaria (se reinicia cada día)" },
        { "value": "fixed", "label": "Fecha fija (campaña real)" },
        { "value": "evergreen", "label": "Por visitante (minutos)" }
      ]
    },
    { "type": "range", "id": "reset_hour", "min": 0, "max": 23, "step": 1, "default": 0, "label": "Hora de reinicio diario", "info": "Solo para el modo diario. 0 = medianoche." },
    { "type": "text", "id": "deadline", "default": "2026-12-31T23:59", "label": "Fecha límite", "info": "Solo para fecha fija. Formato: AAAA-MM-DDTHH:MM" },
    { "type": "range", "id": "minutes", "min": 5, "max": 120, "step": 5, "default": 30, "unit": "min", "label": "Minutos por visitante", "info": "Solo para el modo por visitante." },
    { "type": "checkbox", "id": "show_days", "default": false, "label": "Mostrar días" },
    {
      "type": "select",
      "id": "on_expire",
      "default": "restart",
      "label": "Al terminar",
      "options": [
        { "value": "restart", "label": "Reiniciar" },
        { "value": "hide", "label": "Ocultar la sección" }
      ]
    },
    { "type": "header", "content": "Botón" },
    { "type": "text", "id": "cta_label", "label": "Texto del botón" },
    { "type": "url", "id": "cta_link", "label": "Enlace" },
    { "type": "text", "id": "cta_scroll_target", "label": "O desplazar hasta (selector CSS)" },
    { "type": "header", "content": "Estilo" },
    { "type": "checkbox", "id": "sticky", "default": false, "label": "Fijar al hacer scroll" },
    { "type": "checkbox", "id": "flat_style", "default": false, "label": "Contador claro (sin bloques negros)" },
    { "type": "range", "id": "padding_vertical", "min": 8, "max": 48, "step": 2, "default": 16, "unit": "px", "label": "Espaciado vertical" },
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-2", "label": "Esquema de color" }
  ],
  "presets": [{ "name": "COD · Contador" }]
}
{% endschema %}
