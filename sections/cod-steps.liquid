{{ 'cod-theme.css' | asset_url | stylesheet_tag }}

<div class="cod-section color-{{ section.settings.color_scheme }}" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="cod-section__inner">
    <div class="cod-section__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="cod-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="cod-title cod-title--sm">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <div class="cod-subtitle">{{ section.settings.subheading }}</div>
      {%- endif -%}
    </div>

    <div class="cod-steps">
      {%- for block in section.blocks -%}
        <div class="cod-step" {{ block.shopify_attributes }}>
          <span class="cod-step__num">{{ forloop.index }}</span>
          <h3 class="cod-step__title">{{ block.settings.title }}</h3>
          <p class="cod-step__text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_label != blank -%}
      <div class="cod-center cod-mt">
        <a
          class="cod-btn cod-btn--auto{% if section.settings.cta_pulse %} cod-btn--pulse{% endif %}"
          href="{{ section.settings.cta_link | default: '#' }}"
          {% if section.settings.cta_scroll_target != blank %}data-cod-scroll="{{ section.settings.cta_scroll_target }}"{% endif %}
        >{{ section.settings.cta_label }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "COD · Cómo comprar",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "default": "ASÍ DE FÁCIL", "label": "Línea pequeña" },
    { "type": "text", "id": "heading", "default": "Pedir es cuestión de 1 minuto", "label": "Título" },
    { "type": "richtext", "id": "subheading", "default": "<p>No necesitas tarjeta ni cuenta bancaria. Solo tus datos y listo.</p>", "label": "Subtítulo" },
    { "type": "header", "content": "Botón" },
    { "type": "text", "id": "cta_label", "default": "QUIERO PEDIR EL MÍO", "label": "Texto del botón" },
    { "type": "url", "id": "cta_link", "label": "Enlace" },
    { "type": "text", "id": "cta_scroll_target", "label": "O desplazar hasta (selector CSS)" },
    { "type": "checkbox", "id": "cta_pulse", "default": true, "label": "Animar el botón" },
    { "type": "header", "content": "Estilo" },
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-2", "label": "Esquema de color" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "default": 48, "unit": "px", "label": "Espaciado superior" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "default": 48, "unit": "px", "label": "Espaciado inferior" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Paso",
      "settings": [
        { "type": "text", "id": "title", "default": "Paso", "label": "Título" },
        { "type": "text", "id": "text", "default": "Descripción del paso.", "label": "Texto" }
      ]
    }
  ],
  "presets": [
    {
      "name": "COD · Cómo comprar",
      "blocks": [
        { "type": "step", "settings": { "title": "Llena el formulario", "text": "Escribe tu nombre, celular y dirección. Nada más." } },
        { "type": "step", "settings": { "title": "Confirmamos por WhatsApp", "text": "Te escribimos para validar tu pedido y despacharlo el mismo día." } },
        { "type": "step", "settings": { "title": "Recibes y pagas", "text": "Revisas tu pedido en la puerta de tu casa y pagas en efectivo." } }
      ]
    }
  ]
}
{% endschema %}
