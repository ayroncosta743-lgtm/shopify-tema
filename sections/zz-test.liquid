            },
            {
              "value": "thumbs-up",
              "label": "Pulgar arriba"
            }
          ]
        }
      ]
    },
    {
      "type": "cod_cta",
      "name": "COD · Botón extra",
      "limit": 2,
      "settings": [
        {
          "type": "select",
          "id": "style",
          "default": "primary",
          "label": "Tipo de botón",
          "options": [
            {
              "value": "primary",
              "label": "Principal (al formulario)"
            },
            {
              "value": "whatsapp",
              "label": "WhatsApp"
            }
          ]
        },
        {
          "type": "text",
          "id": "label",
          "default": "PEDIR CON PAGO CONTRA ENTREGA",
          "label": "Texto"
        },
        {
          "type": "text",
          "id": "sublabel",
          "default": "Sin tarjeta · Pagas al recibir",
          "label": "Texto secundario"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace"
        },
        {
          "type": "text",
          "id": "scroll_target",
          "default": "#CodOrderForm",
          "label": "O desplazar hasta (selector CSS)"
        },
        {
          "type": "text",
          "id": "whatsapp_message",
          "default": "Hola! Quiero pedir este producto con pago contra entrega",
          "label": "Mensaje de WhatsApp"
        },
        {
          "type": "checkbox",
          "id": "pulse",
          "default": true,
          "label": "Animar el botón"
        }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "t:sections.main-product.blocks.buy_buttons.name",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "default": true,
          "label": "t:sections.main-product.blocks.buy_buttons.settings.show_dynamic_checkout.label",
          "info": "t:sections.main-product.blocks.buy_buttons.settings.show_dynamic_checkout.info"
        },
        {
          "type": "checkbox",
          "id": "show_gift_card_recipient",
          "default": true,
          "label": "t:sections.main-product.blocks.buy_buttons.settings.show_gift_card_recipient.label",
          "info": "t:sections.main-product.blocks.buy_buttons.settings.show_gift_card_recipient.info"
        },
        {
          "type": "header",
          "content": "⚡ Contra entrega"
        },
        {
          "type": "select",
          "id": "cod_button_action",
          "default": "scroll_to_form",
          "label": "Qué hace el botón principal",
          "info": "«Ir al formulario» es lo correcto si el pedido se toma con EasySell dentro de la misma página.",
          "options": [
            {
              "value": "scroll_to_form",
              "label": "Ir al formulario de contra entrega"
            },
            {
              "value": "add_to_cart",
              "label": "Agregar al carrito (flujo normal)"
            }
          ]
        },
        {
          "type": "text",
          "id": "cod_form_selector",
          "default": "#CodOrderForm",
          "label": "Selector del formulario",
          "info": "Debe coincidir con el ID de la sección «COD · Formulario»."
        },
        {
          "type": "text",
          "id": "cod_button_label",
          "default": "PEDIR AHORA · PAGO CONTRA ENTREGA",
          "label": "Texto del botón",
          "info": "Déjalo vacío para usar el texto estándar del tema."
        },
        {
          "type": "text",
          "id": "cod_button_note",
          "default": "Compra protegida · No pagas nada hasta recibir",
          "label": "Texto bajo el botón"
        },
        {
          "type": "checkbox",
          "id": "cod_button_pulse",
          "default": true,
          "label": "Animar el botón"
        }
      ]
    }
  ]
}
