    {
      "type": "cod_urgency",
      "name": "COD · Urgencia",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Usa datos reales. Mostrar existencias o visitantes falsos es publicidad engañosa (SIC)."
        },
        {
          "type": "checkbox",
          "id": "show_live_count",
          "default": true,
          "label": "Mostrar visitantes en vivo"
        },
        {
          "type": "text",
          "id": "live_text",
          "default": "personas están viendo esto ahora",
          "label": "Texto"
        },
        {
          "type": "range",
          "id": "live_min",
          "min": 1,
          "max": 100,
          "step": 1,
          "default": 12,
          "label": "Mínimo"
        },
        {
          "type": "range",
          "id": "live_max",
          "min": 5,
          "max": 300,
          "step": 5,
          "default": 45,
          "label": "Máximo"
        },
        {
          "type": "range",
          "id": "live_interval",
          "min": 3,
          "max": 30,
          "step": 1,
          "default": 7,
          "unit": "s",
          "label": "Cada cuánto cambia"
        },
        {
          "type": "header",
          "content": "Existencias"
        },
        {
          "type": "checkbox",
          "id": "show_stock",
          "default": true,
          "label": "Mostrar barra de existencias"
        },
        {
          "type": "select",
          "id": "stock_source",
          "default": "real",
          "label": "Origen",
          "options": [
            {
              "value": "real",
              "label": "Inventario real de Shopify"
            },
            {
              "value": "manual",
              "label": "Valor manual"
            }
          ]
        },
        {
          "type": "range",
          "id": "manual_stock",
          "min": 1,
          "max": 100,
          "step": 1,
          "default": 12,
          "label": "Unidades (manual)"
        },
        {
          "type": "range",
          "id": "stock_total",
          "min": 10,
          "max": 500,
          "step": 10,
          "default": 50,
          "label": "Existencias de referencia"
        },
        {
          "type": "text",
          "id": "stock_label",
          "default": "Disponibilidad",
          "label": "Etiqueta"
        },
        {
          "type": "header",
          "content": "Cuenta regresiva"
        },
        {
          "type": "checkbox",
          "id": "show_countdown",
          "default": false,
          "label": "Mostrar cuenta regresiva"
        },
        {
          "type": "text",
          "id": "countdown_text",
          "default": "Tu descuento se reserva por:",
          "label": "Texto"
        },
        {
          "type": "select",
          "id": "countdown_mode",
          "default": "evergreen",
          "label": "Tipo",
          "options": [
            {
              "value": "evergreen",
              "label": "Por visitante"
            },
            {
              "value": "daily",
              "label": "Diaria"
            }
          ]
        },
        {
          "type": "range",
          "id": "countdown_minutes",
          "min": 5,
          "max": 60,
          "step": 5,
          "default": 15,
          "unit": "min",
          "label": "Minutos por visitante"
        },
        {
          "type": "range",
          "id": "countdown_reset_hour",
          "min": 0,
          "max": 23,
          "step": 1,
          "default": 0,
          "label": "Hora de reinicio"
        }
      ]
    },
    {
      "type": "cod_checklist",
      "name": "COD · Argumentos",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Por qué te va a gustar",
          "label": "Título"
        },
        {
          "type": "textarea",
          "id": "items",
          "default": "Calidad que se nota desde el primer uso\nNo pagas nada por adelantado\nTe lo llevamos hasta la puerta de tu casa\nSi no te queda, lo cambiamos",
          "label": "Puntos",
          "info": "Un punto por línea."
        }
      ]
    },
    {
      "type": "cod_delivery",
      "name": "COD · Entrega",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Entrega estimada",
          "label": "Título"
        },
        {
          "type": "range",
          "id": "days_min",
          "min": 1,
          "max": 20,
          "step": 1,
          "default": 1,
          "unit": "d",
          "label": "Desde (días hábiles)"
        },
        {
          "type": "range",
          "id": "days_max",
          "min": 1,
          "max": 30,
          "step": 1,
          "default": 4,
          "unit": "d",
          "label": "Hasta (días hábiles)"
        },
        {
          "type": "text",
          "id": "note",
          "default": "Despachamos el mismo día si pides antes de las 4 p. m.",
          "label": "Nota"
        }
      ]
    },
    {
      "type": "cod_guarantee",
      "name": "COD · Garantía",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Compra sin riesgo",
          "label": "Título"
        },
        {
          "type": "text",
          "id": "text",
          "default": "30 días para cambios. Si no te convence, escríbenos.",
          "label": "Texto"
        },
