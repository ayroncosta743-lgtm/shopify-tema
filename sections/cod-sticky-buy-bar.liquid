{{ 'cod-theme.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign bar_product = section.settings.product | default: product
  assign show_bar = false
  if settings.cod_sticky_enabled and bar_product != blank
    assign show_bar = true
  endif
  assign variant = bar_product.selected_or_first_available_variant
-%}

{%- if show_bar -%}
  <cod-sticky-bar data-watch="{{ section.settings.watch_selector }}">
    <div class="cod-sticky-bar{% if settings.cod_sticky_visibility == 'mobile' %} cod-sticky-bar--mobile-only{% endif %}">
      {%- if bar_product.featured_image -%}
        {{
          bar_product.featured_image
          | image_url: width: 150
          | image_tag: class: 'cod-sticky-bar__media', loading: 'lazy', alt: bar_product.title
        }}
      {%- endif -%}

      <div class="cod-sticky-bar__info">
        <span class="cod-sticky-bar__title">{{ bar_product.title }}</span>
        <span class="cod-sticky-bar__price">
          {{ variant.price | money }}
          {%- if variant.compare_at_price > variant.price -%}
            <span class="cod-sticky-bar__compare">{{ variant.compare_at_price | money }}</span>
          {%- endif -%}
        </span>
      </div>

      <a
        class="cod-btn cod-sticky-bar__cta{% if section.settings.pulse %} cod-btn--pulse{% endif %}"
        href="{{ section.settings.target_selector | default: '#CodOrderForm' }}"
        data-cod-sticky-cta="{{ section.settings.target_selector | default: '#CodOrderForm' }}"
        data-cod-sticky-submit="{{ section.settings.trigger_add_to_cart }}"
      >
        {{ settings.cod_sticky_label | default: 'PEDIR AHORA' }}
      </a>
    </div>
  </cod-sticky-bar>
{%- endif -%}

{% schema %}
{
  "name": "COD · Barra fija",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Aparece al desplazarse y mantiene el botón de compra siempre a la vista. El texto y la visibilidad se configuran en Configuración > ⚡ Conversión COD."
    },
    { "type": "product", "id": "product", "label": "Producto", "info": "En una página de producto se usa automáticamente el producto actual." },
    { "type": "text", "id": "watch_selector", "default": ".product-form__submit", "label": "Elemento a vigilar", "info": "La barra aparece cuando este elemento sale de la pantalla." },
    { "type": "text", "id": "target_selector", "default": "#CodOrderForm", "label": "Destino del botón", "info": "Selector CSS al que se desplaza al hacer clic." },
    { "type": "checkbox", "id": "trigger_add_to_cart", "default": false, "label": "Pulsar «agregar al carrito» tras desplazarse", "info": "Déjalo desactivado si usas el formulario de contra entrega." },
    { "type": "checkbox", "id": "pulse", "default": true, "label": "Animar el botón" }
  ],
  "presets": [{ "name": "COD · Barra fija" }]
}
{% endschema %}
