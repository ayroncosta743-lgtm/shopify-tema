{{ 'cod-theme.css' | asset_url | stylesheet_tag }}

<div class="cod-section color-{{ section.settings.color_scheme }}" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="cod-section__inner cod-section__inner--narrow">
    <div class="cod-section__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="cod-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="cod-title cod-title--sm">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <div class="cod-subtitle">{{ section.settings.subheading }}</div>
      {%- endif -%}
    </div>

    <div class="cod-video" style="--cod-video-ratio: {{ section.settings.ratio }};">
      {%- if section.settings.video != blank -%}
        {{
          section.settings.video
          | video_tag:
            image_size: '1100x',
            autoplay: section.settings.autoplay,
            loop: section.settings.loop,
            muted: section.settings.autoplay,
            controls: true,
            playsinline: true
        }}
      {%- elsif section.settings.video_url != blank -%}
        {%- assign embed = section.settings.video_url -%}
        {%- liquid
          if embed.type == 'youtube'
            assign embed_src = 'https://www.youtube.com/embed/' | append: embed.id | append: '?playsinline=1&rel=0'
          else
            assign embed_src = 'https://player.vimeo.com/video/' | append: embed.id
          endif
        -%}
        <iframe
          class="cod-video__frame"
          src="{{ embed_src }}"
          title="{{ section.settings.heading | escape }}"
          loading="lazy"
          allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      {%- else -%}
        <div class="cod-video__placeholder">{{ 'cod.video.placeholder' | t }}</div>
      {%- endif -%}
    </div>

    {%- if section.settings.cta_label != blank -%}
      <div class="cod-center cod-mt">
        <a
          class="cod-btn cod-btn--auto{% if section.settings.cta_pulse %} cod-btn--pulse{% endif %}"
          href="{{ section.settings.cta_link | default: '#' }}"
          {% if section.settings.cta_scroll_target != blank %}data-cod-scroll="{{ section.settings.cta_scroll_target }}"{% endif %}
        >{{ section.settings.cta_label }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{%- style -%}
  #shopify-section-{{ section.id }} .cod-video {
    position: relative;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    border-radius: var(--cod-radius-lg);
    overflow: hidden;
    box-shadow: var(--cod-shadow);
    background: #000;
    aspect-ratio: var(--cod-video-ratio);
  }

  #shopify-section-{{ section.id }} .cod-video video,
  #shopify-section-{{ section.id }} .cod-video iframe,
  #shopify-section-{{ section.id }} .cod-video__frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .cod-video__placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    color: #fff;
    font-size: 1.4rem;
    opacity: .7;
    text-align: center;
    padding: 2rem;
  }
{%- endstyle -%}

{% schema %}
{
  "name": "COD · Video de venta",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Sube aquí el creativo que ya funciona en TikTok. Ver el producto en uso es lo que más convierte con público frío."
    },
    { "type": "text", "id": "eyebrow", "default": "MÍRALO EN ACCIÓN", "label": "Línea pequeña" },
    { "type": "text", "id": "heading", "default": "Así se ve de verdad", "label": "Título" },
    { "type": "richtext", "id": "subheading", "label": "Subtítulo" },
    { "type": "header", "content": "Video" },
    { "type": "video", "id": "video", "label": "Video alojado en Shopify" },
    { "type": "video_url", "id": "video_url", "accept": ["youtube", "vimeo"], "label": "O enlace de YouTube/Vimeo" },
    { "type": "checkbox", "id": "autoplay", "default": true, "label": "Reproducir automáticamente (sin sonido)" },
    { "type": "checkbox", "id": "loop", "default": true, "label": "Repetir en bucle" },
    {
      "type": "select",
      "id": "ratio",
      "default": "9 / 16",
      "label": "Formato",
      "options": [
        { "value": "9 / 16", "label": "Vertical (TikTok)" },
        { "value": "1 / 1", "label": "Cuadrado" },
        { "value": "4 / 5", "label": "Retrato" },
        { "value": "16 / 9", "label": "Horizontal" }
      ]
    },
    { "type": "range", "id": "max_width", "min": 320, "max": 900, "step": 20, "default": 460, "unit": "px", "label": "Ancho máximo" },
    { "type": "header", "content": "Botón" },
    { "type": "text", "id": "cta_label", "default": "LO QUIERO CON PAGO CONTRA ENTREGA", "label": "Texto del botón" },
    { "type": "url", "id": "cta_link", "label": "Enlace" },
    { "type": "text", "id": "cta_scroll_target", "label": "O desplazar hasta (selector CSS)" },
    { "type": "checkbox", "id": "cta_pulse", "default": true, "label": "Animar el botón" },
    { "type": "header", "content": "Estilo" },
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-1", "label": "Esquema de color" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "default": 48, "unit": "px", "label": "Espaciado superior" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "default": 48, "unit": "px", "label": "Espaciado inferior" }
  ],
  "presets": [{ "name": "COD · Video de venta" }]
}
{% endschema %}
