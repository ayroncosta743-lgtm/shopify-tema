<div class="cod-section color-{{ section.settings.color_scheme }}" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="cod-section__inner">
    <div class="cod-section__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="cod-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="cod-title cod-title--sm">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.show_summary -%}
        <div class="cod-rating-line" style="justify-content: center;">
          {% render 'cod-stars', rating: section.settings.rating_value, size: 'lg' %}
          <span>{{ section.settings.summary_text }}</span>
        </div>
      {%- endif -%}
    </div>

    <div class="cod-reviews{% if section.settings.mobile_carousel %} cod-reviews--scroll{% endif %}">
      {%- for block in section.blocks -%}
        <article class="cod-review" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 700
              | image_tag: class: 'cod-review__media', loading: 'lazy', sizes: '(min-width: 750px) 33vw, 82vw', widths: '300,500,700'
            }}
          {%- endif -%}

          {% render 'cod-stars', rating: block.settings.rating %}

          <p class="cod-review__text">{{ block.settings.text }}</p>

          <div class="cod-review__author">
            {%- if block.settings.avatar != blank -%}
              {{ block.settings.avatar | image_url: width: 120 | image_tag: class: 'cod-review__avatar', loading: 'lazy' }}
            {%- else -%}
              <span class="cod-review__avatar" aria-hidden="true">{{ block.settings.name | slice: 0 | upcase }}</span>
            {%- endif -%}
            <span>
              <span class="cod-review__name">{{ block.settings.name }}</span>
              <span class="cod-review__meta">{{ block.settings.city }}</span>
              {%- if block.settings.verified -%}
                <br>
                <span class="cod-review__verified">
                  {% render 'cod-icon', icon: 'check-circle' %}
                  {{ 'cod.reviews.verified' | t }}
                </span>
              {%- endif -%}
            </span>
          </div>
        </article>
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_label != blank -%}
      <div class="cod-center cod-mt">
        <a
          class="cod-btn cod-btn--auto{% if section.settings.cta_pulse %} cod-btn--pulse{% endif %}"
          href="{{ section.settings.cta_link | default: '#' }}"
          {% if section.settings.cta_scroll_target != blank %}data-cod-scroll="{{ section.settings.cta_scroll_target }}"{% endif %}
        >{{ section.settings.cta_label }}</a>
      </div>
    {%- endif -%}

    {%- if section.settings.disclaimer != blank -%}
      <p class="cod-center cod-mt-sm" style="font-size: 1.2rem; opacity: .6;">{{ section.settings.disclaimer }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "COD · Testimonios",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Publica solo reseñas reales de tus clientes. Inventar testimonios es publicidad engañosa y la SIC puede sancionarte."
    },
    { "type": "text", "id": "eyebrow", "default": "Lo que dicen nuestros clientes", "label": "Línea pequeña" },
    { "type": "text", "id": "heading", "default": "Colombianos que ya lo recibieron", "label": "Título" },
    { "type": "header", "content": "Resumen de calificación" },
    { "type": "checkbox", "id": "show_summary", "default": true, "label": "Mostrar promedio" },
    { "type": "range", "id": "rating_value", "min": 3, "max": 5, "step": 0.1, "default": 4.8, "label": "Promedio" },
    { "type": "text", "id": "summary_text", "default": "4.8 de 5 · basado en reseñas verificadas", "label": "Texto del promedio" },
    { "type": "header", "content": "Botón" },
    { "type": "text", "id": "cta_label", "default": "Quiero el mío", "label": "Texto del botón" },
    { "type": "url", "id": "cta_link", "label": "Enlace" },
    { "type": "text", "id": "cta_scroll_target", "label": "O desplazar hasta (selector CSS)" },
    { "type": "checkbox", "id": "cta_pulse", "default": false, "label": "Animar el botón" },
    { "type": "header", "content": "Estilo" },
    { "type": "checkbox", "id": "mobile_carousel", "default": true, "label": "Carrusel deslizable en móvil" },
    { "type": "text", "id": "disclaimer", "label": "Aviso legal (opcional)" },
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-1", "label": "Esquema de color" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "default": 48, "unit": "px", "label": "Espaciado superior" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "default": 48, "unit": "px", "label": "Espaciado inferior" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Reseña",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Foto del cliente con el producto" },
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "default": 5, "label": "Estrellas" },
        { "type": "textarea", "id": "text", "default": "Llegó rapidísimo y pagué cuando lo recibí. Tal cual como en el video.", "label": "Reseña" },
        { "type": "text", "id": "name", "default": "Carolina M.", "label": "Nombre" },
        { "type": "text", "id": "city", "default": "Bogotá", "label": "Ciudad" },
        { "type": "image_picker", "id": "avatar", "label": "Foto de perfil" },
        { "type": "checkbox", "id": "verified", "default": true, "label": "Marcar como compra verificada" }
      ]
    }
  ],
  "presets": [
    {
      "name": "COD · Testimonios",
      "blocks": [
        { "type": "review", "settings": { "name": "Carolina M.", "city": "Bogotá", "text": "Llegó en 2 días y pagué al recibir. Súper cómodos, ya pedí otro par." } },
        { "type": "review", "settings": { "name": "Andrés G.", "city": "Medellín", "text": "Desconfiaba porque lo vi en TikTok, pero me escribieron por WhatsApp y todo fue real." } },
        { "type": "review", "settings": { "name": "Daniela R.", "city": "Cali", "text": "La talla quedó perfecta y la calidad es muy buena para el precio." } }
      ]
    }
  ]
}
{% endschema %}
