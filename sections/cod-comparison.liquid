{{ 'cod-theme.css' | asset_url | stylesheet_tag }}

<div class="cod-section color-{{ section.settings.color_scheme }}" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="cod-section__inner cod-section__inner--narrow">
    <div class="cod-section__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="cod-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="cod-title cod-title--sm">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    <div class="cod-compare-wrap">
      <table class="cod-compare">
        <thead>
          <tr>
            <th scope="col">{{ section.settings.feature_label }}</th>
            <th scope="col" class="is-us">{{ section.settings.us_label }}</th>
            <th scope="col">{{ section.settings.them_label }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.feature }}</th>
              <td class="is-us">
                {%- if block.settings.us_value != blank -%}
                  {{ block.settings.us_value }}
                {%- else -%}
                  <span class="cod-yes" aria-label="{{ 'cod.compare.yes' | t }}">✓</span>
                {%- endif -%}
              </td>
              <td>
                {%- if block.settings.them_value != blank -%}
                  {{ block.settings.them_value }}
                {%- else -%}
                  <span class="cod-no" aria-label="{{ 'cod.compare.no' | t }}">✕</span>
                {%- endif -%}
              </td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>

    {%- if section.settings.cta_label != blank -%}
      <div class="cod-center cod-mt">
        <a
          class="cod-btn cod-btn--auto{% if section.settings.cta_pulse %} cod-btn--pulse{% endif %}"
          href="{{ section.settings.cta_link | default: '#' }}"
          {% if section.settings.cta_scroll_target != blank %}data-cod-scroll="{{ section.settings.cta_scroll_target }}"{% endif %}
        >{{ section.settings.cta_label }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "COD · Comparativa",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Compara tu propuesta con la alternativa genérica del mercado, sin nombrar ni desprestigiar marcas concretas."
    },
    { "type": "text", "id": "eyebrow", "default": "La diferencia", "label": "Línea pequeña" },
    { "type": "text", "id": "heading", "default": "Por qué comprar aquí y no en cualquier página", "label": "Título" },
    { "type": "text", "id": "feature_label", "default": "Característica", "label": "Encabezado de la primera columna" },
    { "type": "text", "id": "us_label", "default": "Nuestra tienda", "label": "Encabezado de tu columna" },
    { "type": "text", "id": "them_label", "default": "Otras páginas", "label": "Encabezado de la otra columna" },
    { "type": "header", "content": "Botón" },
    { "type": "text", "id": "cta_label", "default": "Pedir ahora", "label": "Texto del botón" },
    { "type": "url", "id": "cta_link", "label": "Enlace" },
    { "type": "text", "id": "cta_scroll_target", "label": "O desplazar hasta (selector CSS)" },
    { "type": "checkbox", "id": "cta_pulse", "default": false, "label": "Animar el botón" },
    { "type": "header", "content": "Estilo" },
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-2", "label": "Esquema de color" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "default": 48, "unit": "px", "label": "Espaciado superior" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "default": 48, "unit": "px", "label": "Espaciado inferior" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Fila",
      "settings": [
        { "type": "text", "id": "feature", "default": "Característica", "label": "Característica" },
        { "type": "text", "id": "us_value", "label": "Tu columna", "info": "Déjalo vacío para mostrar un ✓ verde." },
        { "type": "text", "id": "them_value", "label": "Otra columna", "info": "Déjalo vacío para mostrar una ✕ gris." }
      ]
    }
  ],
  "presets": [
    {
      "name": "COD · Comparativa",
      "blocks": [
        { "type": "row", "settings": { "feature": "Pagas al recibir", "us_value": "", "them_value": "Pago por adelantado" } },
        { "type": "row", "settings": { "feature": "Envío a toda Colombia", "us_value": "Gratis", "them_value": "Con costo" } },
        { "type": "row", "settings": { "feature": "Confirmación por WhatsApp", "us_value": "", "them_value": "" } },
        { "type": "row", "settings": { "feature": "Garantía de 30 días", "us_value": "", "them_value": "" } },
        { "type": "row", "settings": { "feature": "Tiempo de entrega", "us_value": "1 a 4 días", "them_value": "15 a 30 días" } },
        { "type": "row", "settings": { "feature": "Atención en español", "us_value": "", "them_value": "" } }
      ]
    }
  ]
}
{% endschema %}
