{{ 'cod-theme.css' | asset_url | stylesheet_tag }}

<div class="cod-section color-{{ section.settings.color_scheme }}" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="cod-section__inner cod-section__inner--narrow">
    <div class="cod-guarantee">
      <div class="cod-guarantee__seal">
        {%- if section.settings.seal_image != blank -%}
          {{ section.settings.seal_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: section.settings.heading }}
        {%- else -%}
          <span>
            <span class="cod-guarantee__num">{{ section.settings.days }}</span>
            <span class="cod-guarantee__unit">{{ section.settings.days_label }}</span>
          </span>
        {%- endif -%}
      </div>

      <div class="cod-guarantee__body">
        <h2 class="cod-guarantee__title">{{ section.settings.heading }}</h2>
        <div class="cod-guarantee__text">{{ section.settings.text }}</div>

        {%- if section.settings.cta_label != blank -%}
          <div class="cod-mt">
            <a
              class="cod-btn cod-btn--success cod-btn--auto"
              href="{{ section.settings.cta_link | default: '#' }}"
              {% if section.settings.cta_scroll_target != blank %}data-cod-scroll="{{ section.settings.cta_scroll_target }}"{% endif %}
            >{{ section.settings.cta_label }}</a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "COD · Garantía",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Promete solo lo que puedas cumplir. En Colombia la garantía legal mínima es obligatoria (Estatuto del Consumidor, Ley 1480 de 2011)."
    },
    { "type": "range", "id": "days", "min": 5, "max": 90, "step": 5, "default": 30, "label": "Días de garantía" },
    { "type": "text", "id": "days_label", "default": "días", "label": "Texto bajo el número" },
    { "type": "image_picker", "id": "seal_image", "label": "Sello personalizado (opcional)" },
    { "type": "text", "id": "heading", "default": "Garantía de 30 días o te devolvemos tu dinero", "label": "Título" },
    { "type": "richtext", "id": "text", "default": "<p>Si el producto no es lo que esperabas, escríbenos por WhatsApp dentro de los 30 días siguientes a la entrega y coordinamos el cambio o la devolución. Sin letra pequeña.</p>", "label": "Texto" },
    { "type": "header", "content": "Botón" },
    { "type": "text", "id": "cta_label", "default": "Pedir sin riesgo", "label": "Texto del botón" },
    { "type": "url", "id": "cta_link", "label": "Enlace" },
    { "type": "text", "id": "cta_scroll_target", "label": "O desplazar hasta (selector CSS)" },
    { "type": "header", "content": "Estilo" },
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-1", "label": "Esquema de color" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "default": 40, "unit": "px", "label": "Espaciado superior" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "default": 40, "unit": "px", "label": "Espaciado inferior" }
  ],
  "presets": [{ "name": "COD · Garantía" }]
}
{% endschema %}
