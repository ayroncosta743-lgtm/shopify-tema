{{ 'cod-theme.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign items = section.blocks | where: 'type', 'item'
-%}

{%- if items.size > 0 -%}
  <div class="cod-marquee color-{{ section.settings.color_scheme }}">
    <div class="cod-marquee__track" style="--cod-marquee-speed: {{ section.settings.speed }}s;">
      {%- comment -%} Dos grupos idénticos para que el bucle sea continuo {%- endcomment -%}
      {%- for group in (1..2) -%}
        <div class="cod-marquee__group" {% if group == 2 %}aria-hidden="true"{% endif %}>
          {%- for block in items -%}
            <span class="cod-marquee__item" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != 'none' -%}
                {% render 'cod-icon', icon: block.settings.icon %}
              {%- endif -%}
              {{ block.settings.text }}
            </span>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{%- style -%}
  #shopify-section-{{ section.id }} .cod-marquee svg { width: 1.8rem; height: 1.8rem; }
{%- endstyle -%}

{% schema %}
{
  "name": "COD · Deslizante",
  "tag": "section",
  "settings": [
    { "type": "range", "id": "speed", "min": 10, "max": 60, "step": 2, "default": 26, "unit": "s", "label": "Duración del ciclo", "info": "Más segundos = más lento." },
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-3", "label": "Esquema de color" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Mensaje",
      "settings": [
        { "type": "text", "id": "text", "default": "PAGO CONTRA ENTREGA", "label": "Texto" },
        {
          "type": "select",
          "id": "icon",
          "default": "cash",
          "label": "Ícono",
          "options": [
            { "value": "none", "label": "Sin ícono" },
            { "value": "cash", "label": "Efectivo" },
            { "value": "truck", "label": "Envío" },
            { "value": "shield", "label": "Garantía" },
            { "value": "fire", "label": "Fuego" },
            { "value": "star", "label": "Estrella" },
            { "value": "zap", "label": "Rayo" },
            { "value": "check-circle", "label": "Check" },
            { "value": "return", "label": "Devolución" },
            { "value": "map-pin", "label": "Ubicación" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "COD · Deslizante",
      "blocks": [
        { "type": "item", "settings": { "text": "PAGO CONTRA ENTREGA EN TODA COLOMBIA", "icon": "cash" } },
        { "type": "item", "settings": { "text": "ENVÍO GRATIS", "icon": "truck" } },
        { "type": "item", "settings": { "text": "GARANTÍA DE 30 DÍAS", "icon": "shield" } },
        { "type": "item", "settings": { "text": "+2.400 PEDIDOS ENTREGADOS", "icon": "check-circle" } }
      ]
    }
  ]
}
{% endschema %}
