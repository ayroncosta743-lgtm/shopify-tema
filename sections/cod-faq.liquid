<div class="cod-section color-{{ section.settings.color_scheme }}" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="cod-section__inner cod-section__inner--narrow">
    <div class="cod-section__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="cod-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="cod-title cod-title--sm">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <div class="cod-subtitle">{{ section.settings.subheading }}</div>
      {%- endif -%}
    </div>

    <div class="cod-faq">
      {%- for block in section.blocks -%}
        <details class="cod-faq__item" {% if block.settings.open_by_default %}open{% endif %} {{ block.shopify_attributes }}>
          <summary class="cod-faq__q">
            <span>{{ block.settings.question }}</span>
            <span class="cod-faq__icon" aria-hidden="true"></span>
          </summary>
          <div class="cod-faq__a">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_label != blank -%}
      <div class="cod-center cod-mt">
        <a
          class="cod-btn cod-btn--auto"
          href="{{ section.settings.cta_link | default: '#' }}"
          {% if section.settings.cta_scroll_target != blank %}data-cod-scroll="{{ section.settings.cta_scroll_target }}"{% endif %}
        >{{ section.settings.cta_label }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "COD · Preguntas",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Responde aquí las objeciones típicas del tráfico frío: «¿es real?», «¿cuándo llega?», «¿y si no me queda?»."
    },
    { "type": "text", "id": "eyebrow", "default": "Resolvemos tus dudas", "label": "Línea pequeña" },
    { "type": "text", "id": "heading", "default": "Preguntas frecuentes", "label": "Título" },
    { "type": "richtext", "id": "subheading", "label": "Subtítulo" },
    { "type": "header", "content": "Botón" },
    { "type": "text", "id": "cta_label", "default": "Pedir con pago contra entrega", "label": "Texto del botón" },
    { "type": "url", "id": "cta_link", "label": "Enlace" },
    { "type": "text", "id": "cta_scroll_target", "label": "O desplazar hasta (selector CSS)" },
    { "type": "header", "content": "Estilo" },
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-1", "label": "Esquema de color" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "default": 48, "unit": "px", "label": "Espaciado superior" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "default": 48, "unit": "px", "label": "Espaciado inferior" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Pregunta",
      "settings": [
        { "type": "text", "id": "question", "default": "¿Cuándo pago?", "label": "Pregunta" },
        { "type": "richtext", "id": "answer", "default": "<p>Pagas en efectivo cuando el pedido llega a tu casa.</p>", "label": "Respuesta" },
        { "type": "checkbox", "id": "open_by_default", "default": false, "label": "Abierta por defecto" }
      ]
    }
  ],
  "presets": [
    {
      "name": "COD · Preguntas",
      "blocks": [
        { "type": "faq", "settings": { "open_by_default": true, "question": "¿De verdad pago cuando lo recibo?", "answer": "<p>Sí. No pides tarjeta ni transferencia. Haces el pedido, nosotros lo despachamos y pagas en efectivo al transportador cuando te lo entrega en tu casa.</p>" } },
        { "type": "faq", "settings": { "question": "¿Cuánto tarda en llegar?", "answer": "<p>Entre 1 y 4 días hábiles según tu ciudad. Ciudades principales suelen recibir en 24 a 48 horas.</p>" } },
        { "type": "faq", "settings": { "question": "¿Hacen envíos a todo el país?", "answer": "<p>Sí, enviamos a toda Colombia: Bogotá, Medellín, Cali, Barranquilla, Bucaramanga, Cartagena, Pereira y municipios.</p>" } },
        { "type": "faq", "settings": { "question": "¿Y si no me queda la talla?", "answer": "<p>Escríbenos por WhatsApp y coordinamos el cambio. Tienes 30 días desde que recibes el pedido.</p>" } },
        { "type": "faq", "settings": { "question": "¿Puedo revisar el producto antes de pagar?", "answer": "<p>Puedes verificar que el paquete esté en buen estado al recibirlo. Si llega dañado, no lo recibas y avísanos de inmediato.</p>" } },
        { "type": "faq", "settings": { "question": "¿Cómo sé que esto es real?", "answer": "<p>Somos una tienda registrada, te confirmamos el pedido por WhatsApp con una persona real y solo pagas cuando el producto está en tus manos.</p>" } }
      ]
    }
  ]
}
{% endschema %}
